QWidget#titleBar 
{
    background-color: #67462a;
    border: none;
    height: 34px;
    padding-left: 0;
}

QWidget#titleBar > QToolButton 
{
    border: none;
    background: transparent;
    width: 28px;
    height: 28px;
    margin: 1px 0 2px 0;
    padding: 0;
    font-size: 10pt;
    color: white;
}

QWidget#titleBar > QToolButton#minButton,
QWidget#titleBar > QToolButton#maxButton,
QWidget#titleBar > QToolButton#closeButton 
{
    width: 46px;
}

QWidget#titleBar > QToolButton:hover 
{
    background-color: #a9261a;
}

QWidget#titleBar > QToolButton#closeButton:hover 
{
    background-color: rgb(232, 17, 35);
}

QWidget#titleBar > QToolButton#saveButton 
{
    margin-left: 15px !important;
}